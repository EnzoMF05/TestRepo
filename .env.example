# Copia para ".env" (cp .env.example .env) e preenche. O ficheiro .env NÃO vai para o git.

# --- Telegram (obrigatório para receberes sinais; sem isto, imprime na consola) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Comandos /status /stats /pause /resume. Só ligar se este robô tiver um bot do Telegram SÓ SEU
# (dois programas a ler o mesmo bot roubam mensagens um ao outro).
ENABLE_COMMANDS=false

# --- Mercado ---
EXCHANGE=binance        # binance | bybit | okx | kraken (as outras são reserva automática)
BASE=ZEC
QUOTE=USDT
INTERVAL_MIN=15

# --- Sinais ---
SIDE=both               # long | short | both   (em spot só podes fazer long)
ACTIVE_HOURS_UTC=0-24   # ex.: 7-22 para ignorar a madrugada
MAX_SIGNALS_PER_DAY=4
DAILY_STOP_R=3          # depois de -3R no dia, sem mais sinais até às 00:00 UTC
COOLDOWN_BARS=4
MAX_HOLD_BARS=48        # 48 x 15m = 12h

# --- Risco (só afeta o tamanho sugerido nas mensagens) ---
ACCOUNT_SIZE=1000
RISK_PCT=1.0

# --- Custos assumidos (por lado, em %) — ajusta à tua exchange/nível de comissões ---
FEE_PCT=0.05
SLIPPAGE_PCT=0.03

# --- Outros ---
POLL_SECONDS=20
TIMEZONE=Europe/Lisbon
STATE_FILE=zec_state.json
