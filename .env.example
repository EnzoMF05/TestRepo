# Copia para ".env" (cp .env.example .env) e preenche. O ficheiro .env NÃO vai para o git.

# --- Telegram (obrigatório para receberes sinais; sem isto, imprime na consola) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Comandos /status /stats /pause /resume. Só ligar se este robô tiver um bot do Telegram SÓ SEU
# (dois programas a ler o mesmo bot roubam mensagens um ao outro).
ENABLE_COMMANDS=false

# --- Mercado (onde operas) ---
EXCHANGE=hyperliquid    # de onde vêm os candles: hyperliquid | binance | bybit | okx | kraken
# Se a exchange falhar, usar outra? Desligado: preços de outra exchange não batem com o teu gráfico da Hyperliquid.
ALLOW_FALLBACK=false
BASE=ZEC
QUOTE=USDT              # só usado fora da Hyperliquid
INTERVAL_MIN=15

# --- Estratégia ---
# sweep    = o método da mesa (CT-NÍVEL): sweep de nível + pavio + queda de OI, ordem LIMIT na face (ver secção abaixo)
# reversal = reversão por funding extremo da Binance (leitura minha das tuas regras; não é o método da mesa)
# trend    = a favor da tendência | both = reversal + trend, separadas no relatório
STRATEGY=reversal
AVOID_EXPENSIVE_LONGS=true   # sem longs de TENDÊNCIA quando o preço já está caro (>2 ATR acima da EMA55 ou RSI>=70)

# --- Sweep de nível (STRATEGY=sweep): os valores por defeito são os do hourly_scan.py da mesa ---
# Precisa de: (1) uma cópia LOCAL do niveis.csv da mesa (ticker,cluster_below,cluster_above,spot_approx,atualizado_utc;
# níveis separados por | ou ;) e (2) pelo menos uma chave de OI 1H (a cascata é CoinGlass -> Coinalyze).
# Avalia às :02 de cada hora a vela 1H fechada. Não é backtestável (não há histórico dos níveis).
NIVEIS_PATH=niveis.csv
NIVEIS_MAX_AGE_H=0          # 0 = nunca bloqueia por idade dos níveis (como a mesa); >0 = ignora níveis mais velhos
COINGLASS_API_KEY=          # OI 1H do perp da Binance via CoinGlass (1ª fonte)
COINALYZE_API_KEY=          # OI 1H do perp da Binance via Coinalyze (2ª fonte; símbolo ZECUSDT_PERP.A)
SWEEP_OI_MAX_PCT=-3         # L2: OI da hora <= -3%
SWEEP_WICK_MIN_PCT=50       # L1: pavio >= 50% da amplitude
SWEEP_STOP_ATR=0.1          # stop = extremo da vela +/- 0.1 ATR14
SWEEP_TARGET_R=1.5
SWEEP_R_MAX_ATR=1.2         # veto se |limite-stop| > 1.2 ATR14
SWEEP_COST_SIDE_PCT=0.035   # maker 0.015% + derrapagem 0.02% por lado (entra no R)
SWEEP_REQUIRE_RECLAIM=false # true = exigir fecho de volta dentro do nível (no original da mesa esta opção não fazia nada)
SWEEP_VALID_H=4             # o trade deixa de valer ao fim de 4h ...
SWEEP_CANCEL_H=2            # ... e o limite sem fill cancela ao fim de 2h
SWEEP_COUNT_FROM_ALERT=false # false = como o original: contar desde a ABERTURA da vela varrida (=> cancela 1h após o alerta)
SWEEP_SETTLE_S=125          # espera após o fecho da hora antes de avaliar (a mesa corre às :02:05)
SWEEP_OI_ATTEMPTS=3         # tentativas se a fonte de OI ainda não tiver a vela
SWEEP_OI_RETRY_S=20
SWEEP_JOURNAL=zec_sweep_journal.csv   # mesmo cabeçalho do journal da mesa
SWEEP_RESULTS=zec_sweep_results.csv   # resultado de cada ordem em paper (fill, alvo/stop/validade, R)

# --- Reversão: quão "carregado" tem de estar o mercado ---
# Funding do perp ZECUSDT da Binance (o mesmo que vês no Coinalyze), em %/8h. Dados públicos, sem chave.
# O percentil compara o funding atual com os últimos CROWD_WINDOW_DAYS dias DO PRÓPRIO ativo (não adivinho o que é "alto"
# no ZEC); o mínimo absoluto impede que um funding perto de zero conte como extremo. A base da Binance é 0.01.
CROWD_WINDOW_DAYS=30
REV_SHORT_MIN_PCTL=90           # SHORT quando os longs estão sobrelotados: funding >= P90 ...
REV_SHORT_MIN_FUNDING_8H=0.03   # ... e >= +0.03%/8h
REV_LONG_MAX_PCTL=5             # LONG quando os shorts estão EXTREMAMENTE sobrelotados: funding <= P5 ...
REV_LONG_MAX_FUNDING_8H=-0.02   # ... e <= -0.02%/8h
# Exigir também open interest a subir (posições a acumular). Só se consegue testar ~30 dias (limite da Binance).
REV_USE_OI=false
REV_OI_HOURS=24
REV_OI_MIN_PCT=3

# --- Filtros opcionais da estratégia de TENDÊNCIA (desligados; não afetam a reversão) ---
# Só liga depois de correr `python -m zec_bot.backtest --strategy trend --funding-filter` e ver que ajudam.
FUNDING_FILTER=false    # sem longs com funding muito alto / sem shorts com funding muito negativo
FUNDING_LIMIT_8H_PCT=0.05
OI_FILTER=false         # rutura (breakout) só com open interest a subir
OI_MIN_CHANGE_PCT=0
OI_LOOKBACK_HOURS=1

# --- Sinais ---
SIDE=both               # long | short | both
ACTIVE_HOURS_UTC=0-24   # ex.: 7-22 para ignorar a madrugada
MAX_SIGNALS_PER_DAY=4
DAILY_STOP_R=3          # depois de -3R no dia, sem mais sinais até às 00:00 UTC
COOLDOWN_BARS=4
MAX_HOLD_BARS=48        # 48 x 15m = 12h

# --- Risco (só afeta o tamanho sugerido nas mensagens) ---
ACCOUNT_SIZE=1000
RISK_PCT=1.0

# --- Custos assumidos (por lado, em %) — 0.045 = taker base da Hyperliquid; ajusta ao teu nível/desconto ---
FEE_PCT=0.045
SLIPPAGE_PCT=0.03

# --- Outros ---
POLL_SECONDS=20
TIMEZONE=Europe/Lisbon
STATE_FILE=zec_state.json
