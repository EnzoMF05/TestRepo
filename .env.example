# Copia para ".env" (cp .env.example .env) e preenche. O ficheiro .env NÃO vai para o git.

# --- Telegram (obrigatório para receberes sinais; sem isto, imprime na consola) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Comandos /status /stats /pause /resume. Só ligar se este robô tiver um bot do Telegram SÓ SEU
# (dois programas a ler o mesmo bot roubam mensagens um ao outro).
ENABLE_COMMANDS=false

# --- Mercado ---
EXCHANGE=hyperliquid    # hyperliquid | binance | bybit | okx | kraken
# Se a exchange falhar, usar outra? Desligado: preços de outra exchange não batem com o teu gráfico da Hyperliquid.
ALLOW_FALLBACK=false
BASE=ZEC
QUOTE=USDT              # só usado fora da Hyperliquid
INTERVAL_MIN=15

# --- Derivados: funding e open interest (a Hyperliquid dá-os grátis, sem chave) ---
# Opcional: chave gratuita do Coinalyze. Dá histórico de OI logo no arranque (senão o robô leva ~1h a juntar amostras).
COINALYZE_API_KEY=
# Opcional: o símbolo do ZEC na Hyperliquid como aparece no Coinalyze. Vazio = descobrir sozinho.
COINALYZE_SYMBOL=
# Filtros (DESLIGADOS: só liga depois de correr `python -m zec_bot.backtest --funding-filter` e ver que ajudam)
FUNDING_FILTER=false    # sem longs com funding muito alto / sem shorts com funding muito negativo
FUNDING_LIMIT_8H_PCT=0.05   # limite em % por 8h (a base da Hyperliquid é 0.01)
OI_FILTER=false         # rutura (breakout) só com open interest a subir
OI_MIN_CHANGE_PCT=0
OI_LOOKBACK_HOURS=1

# --- Sinais ---
SIDE=both               # long | short | both
ACTIVE_HOURS_UTC=0-24   # ex.: 7-22 para ignorar a madrugada
MAX_SIGNALS_PER_DAY=4
DAILY_STOP_R=3          # depois de -3R no dia, sem mais sinais até às 00:00 UTC
COOLDOWN_BARS=4
MAX_HOLD_BARS=48        # 48 x 15m = 12h

# --- Risco (só afeta o tamanho sugerido nas mensagens) ---
ACCOUNT_SIZE=1000
RISK_PCT=1.0

# --- Custos assumidos (por lado, em %) — 0.045 = taker base da Hyperliquid; ajusta ao teu nível/desconto ---
FEE_PCT=0.045
SLIPPAGE_PCT=0.03

# --- Outros ---
POLL_SECONDS=20
TIMEZONE=Europe/Lisbon
STATE_FILE=zec_state.json
